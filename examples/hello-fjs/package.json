    "dev:web": "fjs dev --web",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@ufjs/cli": "workspace:*",
    "@ufjs/runtime": "workspace:*",
