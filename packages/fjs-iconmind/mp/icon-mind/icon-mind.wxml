<!-- See icon-mind.js: skyline has no inline SVG, so the icon is an SVG data
     URI drawn by an image; the box keeps its size while the data is empty. -->
<image wx:if="{{ src }}" class="fjs-icon-mind" src="{{ src }}" style="width: {{ px }}px; height: {{ px }}px;" />
<view wx:else class="fjs-icon-mind" style="width: {{ px }}px; height: {{ px }}px;" />
