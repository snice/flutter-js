{
  "name": "demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fjs dev",
    "dev:pages": "fjs dev --pages",
    "dev:web": "vite --host 0.0.0.0",
    "build": "fjs build",
    "build:bytecode": "fjs build --bytecode",
    "build:pages": "fjs build --pages",
    "build:web": "vite build",
    "run:android": "fjs run android",
    "run:ios": "fjs run ios",
