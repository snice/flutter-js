/* the host carries the page's classes (and the default host class from
   app.wxss); the root lays the children out. Skyline has no `inherit` for
   flex properties, so the compiler copies the page's layout declarations
   into the `layout` property, applied inline here. Defaults match the
   host's (base-css.ts). */
.fjs-host-root {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8px;
  flex-grow: 1;
  min-width: 0;
}
.fjs-choice--disabled {
  opacity: 0.5;
}

/* values follow base-css.ts (.fjs-checkbox / .fjs-check) */
.fjs-checkbox {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border: 2px solid #b0b0b0;
  border-radius: 4px;
  box-sizing: border-box;
}
.fjs-checkbox.on {
  background-color: #007aff;
  border-color: #007aff;
}
.fjs-check {
  width: 10px;
  height: 5px;
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: translateY(-1px) rotate(-45deg);
}
