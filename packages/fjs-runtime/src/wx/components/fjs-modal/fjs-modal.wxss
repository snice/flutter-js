/* Values follow the web overlay component (web/base-css.ts .fjs-modal*):
   a bottom sheet, not a centered dialog. */
.fjs-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  z-index: 1000;
}
.fjs-modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
}
.fjs-modal-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 12px 12px 0 0;
  padding: 16px;
  max-height: 80vh;
  box-sizing: border-box;
}
