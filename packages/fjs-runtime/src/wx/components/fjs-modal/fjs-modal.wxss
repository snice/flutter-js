/* Values follow the web overlay component (web/base-css.ts). */
.fjs-modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.fjs-modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}
.fjs-modal-body {
  position: relative;
  background-color: #ffffff;
  border-radius: 12px;
  padding: 20px;
  max-width: 80%;
}
