{
  "name": "hello-fjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fjs dev",
    "dev:pages": "fjs dev --pages",
    "dev:web": "vite --host 0.0.0.0",
    "dev:web:fjs": "fjs dev --web",
    "build": "fjs build",
    "build:bytecode": "fjs build --bytecode",
    "build:pages": "fjs build --pages",
    "build:pages:bytecode": "fjs build --pages --bytecode",
    "build:web": "vite build",
    "build:web:fjs": "fjs build --web",
    "build:release": "fjs build --pages --release",
    "build:apk": "fjs build --pages --release --apk",
    "run:android": "fjs run android",
    "run:ios": "fjs run ios",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@ufjs/iconmind": "workspace:*",
    "@ufjs/webview": "workspace:*",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@ufjs/cli": "workspace:*",
    "@ufjs/runtime": "workspace:*",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
